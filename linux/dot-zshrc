# init
export LC_MESSAGES="en_US.UTF-8"
autoload -Uz compinit && compinit
zmodload -i zsh/complist

# Lines configured by zsh-newuser-install
HISTFILE=~/.cache/zsh/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt EXTENDED_HISTORY HIST_IGNORE_DUPS HIST_FIND_NO_DUPS
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_REDUCE_BLANKS HIST_SAVE_NO_DUPS
setopt SHARE_HISTORY
setopt AUTO_CD
unsetopt RM_STAR_SILENT
setopt PRINT_EXIT_VALUE
setopt AUTO_REMOVE_SLASH

# change editor to neovim
export EDITOR=nvim

# mise config
eval "$(mise activate zsh)"

# ------------------- path setting ----------------------

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cabal/bin:$HOME/.ghcup/bin:$PATH"
#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

# ccache
export PATH="/usr/lib/ccache/bin:$PATH"

alias ls='ls --color=auto'
alias ll='ls -l -h'
alias diff='diff --color=auto'
alias grep='grep --color=auto'
alias ip='ip -color=auto'
alias vi='nvim'
alias neovide='~/.local/bin/disown_run.sh neovide'

eval $(thefuck --alias)

# private api_key environment variable
set -a
source "$HOME/.config/private_passport.conf"
set +a

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
